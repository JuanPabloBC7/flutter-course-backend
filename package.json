{
  "name": "credit-cards-api",
  "version": "1.0.0",
  "description": "API REST para gestión de tarjetas de crédito (Node.js + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/credit-cards/database/migrate.ts",
    "nodes:worker": "ts-node src/scaling-nodes/worker-node.ts",
    "nodes:balancer": "ts-node src/scaling-nodes/balancer.ts",
    "nodes:test": "ts-node src/scaling-nodes/test.ts",
    "ram:seed": "ts-node src/ram-memory/seed.ts",
    "ram:pipeline": "ts-node src/ram-memory/pipeline.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand card-validator",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.12",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
